{
  "expo": {
    "name": "PetMe",
    "slug": "petme",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#061426",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#061426"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.petme.app"
    },
    "android": {
      "package": "com.petme.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#061426"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "PetMe uses your photos so you can choose a video of your fish tank.",
          "cameraPermission": "PetMe uses the camera so you can film your fish tank.",
          "microphonePermission": "PetMe records sound with tank videos. The app plays them muted."
        }
      ],
      "expo-video"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
