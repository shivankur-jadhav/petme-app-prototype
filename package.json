{
  "name": "petme-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "setup": "npm install && npx expo install react react-native react-dom react-native-web expo-status-bar expo-font expo-linear-gradient expo-blur expo-haptics react-native-reanimated react-native-worklets react-native-safe-area-context react-native-svg @react-native-async-storage/async-storage expo-video expo-image-picker expo-file-system @expo-google-fonts/space-grotesk @expo-google-fonts/inter && npx expo install typescript @types/react -- --save-dev",
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-file-system": "~58.0.0",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.0",
    "expo-linear-gradient": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "expo-video": "~58.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
